# research-swarm configuration. Copy to `.env` before first use.
# `.env` is gitignored.

# ── Backend selection ─────────────────────────────────────────────────
# Default: auto. CLI flags override this value, so
# `research-agent --backend codex "..."` wins over RA_BACKEND=dspy.
#
# auto uses DSPy when this file or the shell provides LM_MODEL / API
# credentials; otherwise it uses Codex when `codex app-server` is
# available.
RA_BACKEND=auto                    # auto | codex | dspy

# ── Codex app-server backend ─────────────────────────────────────────
# Uses your installed Codex app-server session/subscription. Python still
# owns all research tools, caches, and archive writes.
# CODEX_BIN=codex
# CODEX_MODEL=gpt-5.4
# CODEX_EFFORT=low
# CODEX_TIMEOUT_SEC=600
# CODEX_RPC_LOG=0
# CODEX_CONTROL_STDIO_LIMIT=16777216
# RA_TOOL_RESULT_MAX_CHARS=12000
# RA_CONTEXT_MAX_CHARS=48000

# ── DSPy LM provider ─────────────────────────────────────────────────
# The DSPy backend uses litellm, so any provider litellm supports works.
#
# Fully-local (no API key, free):
#   LM_MODEL=ollama/qwen3:35b
#
# vLLM / llama.cpp / LM Studio (OpenAI-compatible local server):
#   LM_MODEL=openai/my-model
#   LM_API_BASE=http://localhost:8000/v1
#
# Anthropic (default shape):
#   LM_MODEL=anthropic/claude-sonnet-4-6
#   LM_API_KEY=sk-ant-...
#
# OpenAI:
#   LM_MODEL=openai/gpt-4o
#   LM_API_KEY=sk-...

# Backward-compat shorthand (used when LM_MODEL is not set):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional tuning
# LM_MAX_TOKENS=16384
# LM_TEMPERATURE=0.3

# ── Web search ────────────────────────────────────────────────────────
# DDG is always used (zero-config). Optionally point at a SearXNG
# instance you trust or self-host:
# SEARXNG_URL=http://localhost:8888

# ── GitHub (optional) ─────────────────────────────────────────────────
# Raises the GitHub rate limit from 60 to 5000 req/hr. Fine-grained PAT
# with public-repo read-only scope is plenty.
# GITHUB_TOKEN=ghp_...

# ── Semantic Scholar (optional) ───────────────────────────────────────
# Works without a key, but throttled. Request one if you hit limits.
# SEMANTIC_SCHOLAR_API_KEY=...

# ── world_knowledge write-through ─────────────────────────────────────
# Default: ~/world_knowledge/. Override path, or disable write-through
# entirely for sandboxed runs.
# RA_WORLD_KNOWLEDGE_DIR=/path/to/archive
# RA_WORLD_KNOWLEDGE=0

# ── fetch_url cache ───────────────────────────────────────────────────
# RA_CACHE_DIR=.ra_cache/fetch
# RA_CACHE_TTL_SEC=604800        # 7 days
# RA_DISABLE_JINA=1              # never fall back to r.jina.ai

# ── web_search cache ──────────────────────────────────────────────────
# RA_CACHE_HIT_MIN=3             # min rows to count as a cache hit
# RA_CACHE_TTL_SEARCH=604800     # 7 days
# RA_BYPASS_CACHE=1              # force network for all queries

# ── Verbose logging ───────────────────────────────────────────────────
# RA_VERBOSE=1
